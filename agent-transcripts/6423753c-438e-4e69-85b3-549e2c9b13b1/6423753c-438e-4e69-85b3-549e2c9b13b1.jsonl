x; } .hero-sub strong { color: var(--primary-dark); } .hero-actions { display: grid; gap: 10px; margin-top: 24px; } .primary-btn { display: inline-flex; justify-content: center; align-items: center; min-height: 58px; padding: 0 22px; border-radius: 18px; border: 0; background: linear-gradient(135deg, var(--primary), var(--blue)); color: #fff; font-size: 17px; font-weight: 900; letter-spacing: -0.3px; box-shadow: 0 16px 28px rgba(70, 84, 220, 0.28); cursor: pointer; } .primary-btn:active { transform: translateY(1px); } .helper-copy { margin: 0; text-align: center; font-size: 12px; color: var(--gray-500); line-height: 1.4; } .visual-card { position: relative; min-height: 230px; border-radius: var(--radius-lg); background: linear-gradient(135deg, rgba(255,255,255,0.92), rgba(244,248,255,0.94)), radial-gradient(circle at 22% 22%, rgba(109,93,252,0.16), transparent 30%), radial-gradient(circle at 80% 18%, rgba(30,155,255,0.16), transparent 28%); box-shadow: var(--shadow); border: 1px solid rgba(255,255,255,0.9); overflow: hidden; } .clay-character { position: absolute; left: 50%; top: 52%; width: 168px; height: 178px; transform: translate(-50%, -50%); } .clay-head { position: absolute; left: 36px; top: 4px; width: 96px; height: 88px; border-radius: 42% 42% 46% 46%; background: linear-gradient(145deg, #fff8ef, #ffd8b7); box-shadow: inset -10px -10px 18px rgba(206, 123, 87, 0.16), 0 14px 24px rgba(84, 68, 126, 0.16); z-index: 3; } .clay-hair { position: absolute; left: 31px; top: -2px; width: 106px; height: 54px; border-radius: 48px 48px 26px 26px; background: linear-gradient(145deg, #25245f, #4334b4); z-index: 4; box-shadow: inset -6px -8px 12px rgba(0,0,0,0.12); } .clay-eye { position: absolute; top: 50px; width: 9px; height: 9px; border-radius: 999px; background: #27223f; z-index: 5; } .clay-eye.left { left: 63px; } .clay-eye.right { right: 63px; } .clay-smile { position: absolute; left: 72px; top: 66px; width: 24px; height: 12px; border-bottom: 3px solid #d07a76; border-radius: 0 0 20px 20px; z-index: 5; } .clay-body { position: absolute; left: 29px; top: 82px; width: 110px; height: 92px; border-radius: 34px 34px 28px 28px; background: linear-gradient(145deg, #6d5dfc, #1e9bff); box-shadow: inset -12px -12px 20px rgba(31, 34, 119, 0.18), 0 16px 26px rgba(70, 84, 220, 0.22); z-index: 2; } .clay-badge { position: absolute; left: 66px; top: 104px; width: 36px; height: 36px; border-radius: 999px; background: #fff; color: var(--primary); font-size: 17px; font-weight: 950; display: flex; align-items: center; justify-content: center; z-index: 4; box-shadow: 0 8px 16px rgba(28, 33, 97, 0.16); } .clay-arm { position: absolute; top: 104px; width: 44px; height: 26px; border-radius: 999px; background: linear-gradient(145deg, #ffd8b7, #ffc09c); box-shadow: 0 8px 16px rgba(84, 68, 126, 0.12); z-index: 1; } .clay-arm.left { left: 4px; transform: rotate(-22deg); } .clay-arm.right { right: 4px; transform: rotate(22deg); } .floating-coupon { position: absolute; right: 24px; bottom: 22px; width: 118px; padding: 13px 10px; border-radius: 18px; background: #fff; box-shadow: 0 14px 26px rgba(45, 43, 101, 0.16); transform: rotate(-4deg); z-index: 5; text-align: center; } .floating-coupon b { display: block; color: var(--primary-dark); font-size: 21px; line-height: 1; letter-spacing: -1px; } .floating-coupon span { display: block; margin-top: 5px; font-size: 11px; color: var(--gray-700); font-weight: 800; } .floating-ball { position: absolute; left: 28px; bottom: 28px; width: 56px; height: 56px; border-radius: 999px; background: radial-gradient(circle at 34% 28%, #fff 0 12%, transparent 13%), linear-gradient(135deg, #ffffff 0 48%, #dce7ff 49% 100%); box-shadow: 0 12px 22px rgba(45, 43, 101, 0.14); opacity: 0.9; } .overview { margin: 0 20px; padding: 22px 18px; border-radius: var(--radius-lg); background: linear-gradient(135deg, #312e81, #5b4df0 55%, #168bff); color: #fff; box-shadow: var(--shadow); } .overview h2 { margin: 0; font-size: 20px; line-height: 1.25; letter-spacing: -0.8px; } .overview-flow { display: grid; grid-template-columns: 1fr; gap: 10px; margin-top: 18px; } .overview-step { display: grid; grid-template-columns: 34px 1fr; gap: 12px; align-items: center; padding: 14px; border-radius: 18px; background: rgba(255,255,255,0.13); border: 1px solid rgba(255,255,255,0.16); backdrop-filter: blur(8px); } .step-num { width: 34px; height: 34px; border-radius: 999px; display: flex; align-items: center; justify-content: center; background: #fff; color: var(--primary-dark); font-weight: 950; font-size: 15px; } .overview-step p { margin: 0; font-size: 16px; font-weight: 850; letter-spacing: -0.4px; } .flow-arrow { text-align: center; opacity: 0.85; font-weight: 900; font-size: 18px; line-height: 1; } .section-title { margin: 0; color: var(--indigo); font-size: 25px; line-height: 1.22; letter-spacing: -1px; font-weight: 950; } .section-desc { margin: 10px 0 0; color: var(--gray-700); font-size: 15px; line-height: 1.55; font-weight: 600; } .method-list { display: grid; gap: 14px; margin-top: 22px; } .method-card { position: relative; display: grid; grid-template-columns: 54px 1fr; gap: 14px; align-items: center; padding: 18px; border-radius: var(--radius-md); background: rgba(255,255,255,0.92); border: 1px solid rgba(109, 93, 252, 0.1); box-shadow: var(--soft-shadow); } .method-icon { width: 54px; height: 54px; border-radius: 20px; display: flex; align-items: center; justify-content: center; background: linear-gradient(135deg, var(--lavender), var(--sky)); color: var(--primary-dark); font-size: 24px; font-weight: 950; } .method-card h3 { margin: 0; font-size: 18px; color: var(--gray-900); letter-spacing: -0.6px; } .method-card p { margin: 5px 0 0; color: var(--gray-700); font-size: 14px; line-height: 1.45; font-weight: 600; } .method-divider { text-align: center; color: var(--primary); font-size: 20px; font-weight: 900; line-height: 0.5; } .coupon-zone { background: linear-gradient(180deg, rgba(242,239,255,0.72), rgba(234,246,255,0.52)); border-top: 1px solid rgba(109, 93, 252, 0.08); border-bottom: 1px solid rgba(30, 155, 255, 0.08); } .coupon-list { display: grid; gap: 18px; margin-top: 22px; } .coupon-card { position: relative; padding: 20px; border-radius: 30px; background: #fff; box-shadow: var(--shadow); border: 1px solid rgba(109, 93, 252, 0.12); overflow: hidden; } .coupon-card::before, .coupon-card::after { content: \"\"; position: absolute; top: 50%; width: 28px; height: 28px; border-radius: 999px; background: #f4f5ff; transform: translateY(-50%); z-index: 2; } .coupon-card::before { left: -14px; } .coupon-card::after { right: -14px; } .coupon-label { display: inline-flex; align-items: center; padding: 8px 11px; border-radius: 999px; background: var(--soft-purple); color: var(--primary-dark); font-size: 13px; font-weight: 900; letter-spacing: -0.3px; } .coupon-card h3 { margin: 16px 0 0; color: var(--indigo); font-size: 24px; line-height: 1.15; letter-spacing: -1px; font-weight: 950; } .coupon-amount { display: flex; align-items: flex-end; gap: 4px; margin-top: 10px; color: var(--primary); font-weight: 950; letter-spacing: -1.4px; } .coupon-amount strong { font-size: 46px; line-height: 1; } .coupon-amount span { padding-bottom: 5px; font-size: 22px; } .coupon-condition { margin: 14px 0 0; padding: 14px; border-radius: 18px; background: #f7f8ff; color: var(--gray-700); font-size: 14px; line-height: 1.5; font-weight: 650; } .save-btn { width: 100%; min-height: 54px; margin-top: 16px; border: 0; border-radius: 17px; background: var(--indigo); color: #fff; font-size: 16px; font-weight: 900; letter-spacing: -0.3px; cursor: pointer; box-shadow: 0 12px 20px rgba(37,36,95,0.18); } .save-btn:active { transform: translateY(1px); } .coupon-note { margin: 14px 2px 0; color: var(--gray-500); font-size: 12px; line-height: 1.5; text-align: center; } .notice-card { margin-top: 22px; padding: 20px; border-radius: var(--radius-md); background: #fff; border: 1px solid rgba(109, 93, 252, 0.1); box-shadow: var(--soft-shadow); } .notice-list { margin: 0; padding: 0; list-style: none; display: grid; gap: 11px; } .notice-list li { position: relative; padding-left: 20px; color: var(--gray-700); font-size: 14px; line-height: 1.45; font-weight: 650; } .notice-list li::before { content: \"✓\"; position: absolute; left: 0; top: 0; color: var(--primary); font-weight: 950; } .trainer-card { position: relative; margin-top: 22px; padding: 24px 20px; border-radius: 30px; background: radial-gradient(circle at 86% 16%, rgba(30,155,255,0.18), transparent 28%), linear-gradient(135deg, #ffffff, #f5f2ff); border: 1px solid rgba(109, 93, 252, 0.12); box-shadow: var(--shadow); overflow: hidden; } .trainer-badge { display: inline-flex; align-items: center; gap: 7px; padding: 8px 12px; border-radius: 999px; background: #fff; color: var(--primary-dark); box-shadow: var(--soft-shadow); font-size: 12px; font-weight: 900; } .trainer-card h2 { margin: 16px 0 0; color: var(--indigo); font-size: 24px; line-height: 1.22; letter-spacing: -1px; } .trainer-card p { margin: 10px 0 0; color: var(--gray-700); font-size: 14px; line-height: 1.55; font-weight: 600; } .trainer-actions { display: grid; gap: 10px; margin-top: 18px; } .secondary-btn { display: inline-flex; justify-content: center; align-items: center; min-height: 52px; padding: 0 18px; border-radius: 17px; background: #fff; border: 1px solid rgba(109, 93, 252, 0.18); color: var(--primary-dark); font-size: 15px; font-weight: 900; box-shadow: var(--soft-shadow); } .footer { padding: 18px 20px 30px; color: var(--gray-500); font-size: 12px; line-height: 1.55; text-align: center; } .sticky-cta { position: fixed; left: 50%; bottom: 0; z-index: 30; width: 100%; max-width: 720px; transform: translateX(-50%); padding: 12px 16px calc(12px + var(--safe-bottom)); background: rgba(255,255,255,0.86); backdrop-filter: blur(16px); border-top: 1px solid rgba(109, 93, 252, 0.1); } .sticky-cta .primary-btn { width: 100%; min-height: 56px; } .toast { position: fixed; left: 50%; bottom: 86px; z-index: 40; width: calc(100% - 40px); max-width: 420px; transform: translateX(-50%) translateY(20px); padding: 14px 16px; border-radius: 16px; background: rgba(35, 35, 53, 0.94); color: #fff; font-size: 14px; line-height: 1.45; font-weight: 700; opacity: 0; pointer-events: none; transition: 0.24s ease; text-align: center; } .toast.is-active { opacity: 1; transform: translateX(-50%) translateY(0); } @media (min-width: 680px) { .hero-inner { grid-template-columns: 1.05fr 0.95fr; align-items: center; } .hero-actions { max-width: 340px; } .coupon-list { grid-template-columns: 1fr 1fr; } .trainer-actions { grid-template-columns: 1fr 1fr; } } </style> </head> <body> <main class=\"page\"> <section class=\"hero\"> <div class=\"hero-inner\"> <div> <div class=\"brand-pill\"> <span class=\"brand-dot\"></span> SK텔레콤 단골 혜택 </div> <h1 class=\"hero-title\"> 포켓몬 협업 기념 <span>단골등록 이벤트</span> </h1> <p class=\"hero-sub\"> 단골등록 후<br /> <strong>폴더블 사전예약</strong>하면<br /> 추가 할인 쿠폰을 받을 수 있어요. </p> <div class=\"hero-actions\"> <a class=\"primary-btn\" href=\"https://m.tworld.co.kr/customer/store\" target=\"_blank\" rel=\"noopener\"> 단골등록 하러가기 </a> <p class=\"helper-copy\">원하는 SK텔레콤 매장을 찾고 친구맺기해 주세요.</p> </div> </div> <div class=\"visual-card\" aria-hidden=\"true\"> <div class=\"clay-character\"> <div class=\"clay-arm left\"></div> <div class=\"clay-arm right\"></div> <div class=\"clay-body\"></div> <div class=\"clay-badge\">T</div> <div class=\"clay-head\"></div> <div class=\"clay-hair\"></div> <div class=\"clay-eye left\"></div> <div class=\"clay-eye right\"></div> <div class=\"clay-smile\"></div> </div> <div class=\"floating-ball\"></div> <div class=\"floating-coupon\"> <b>10만원</b> <span>추가 할인 쿠폰</span> </div> </div> </div> </section> <section class=\"overview\" aria-labelledby=\"overview-title\"> <h2 id=\"overview-title\">참여 방법 한눈에 보기</h2> <div class=\"overview-flow\"> <div class=\"overview-step\"> <div class=\"step-num\">1</div> <p>단골등록</p> </div> <div class=\"flow-arrow\">↓</div> <div class=\"overview-step\"> <div class=\"step-num\">2</div> <p>폴더블 사전예약</p> </div> <div class=\"flow-arrow\">↓</div> <div class=\"overview-step\"> <div class=\"step-num\">3</div> <p>쿠폰 저장</p> </div> <div class=\"flow-arrow\">↓</div> <div class=\"overview-step\"> <div class=\"step-num\">4</div> <p>매장에서 쿠폰 사용</p> </div> </div> </section> <section class=\"section\" aria-labelledby=\"method-title\"> <h2 class=\"section-title\" id=\"method-title\">이벤트 참여 방법</h2> <p class=\"section-desc\"> 먼저 원하는 매장을 찾고 친구맺기해 주세요. 사전예약 등록은 매장에서 진행됩니다. </p> <div class=\"method-list\"> <article class=\"method-card\"> <div class=\"method-icon\">①</div> <div> <h3>매장 찾기</h3> <p>아래 버튼을 눌러 원하는 SK텔레콤 매장을 찾아 주세요.</p> </div> </article> <div class=\"method-divider\">↓</div> <article class=\"method-card\"> <div class=\"method-icon\">②</div> <div> <h3>친구맺기<span style=\"color:#6d5dfc;\">(단골등록)</span></h3> <p>선택한 매장에서 친구맺기를 완료해 주세요.</p> </div> </article> <div class=\"method-divider\">↓</div> <article class=\"method-card\"> <div class=\"method-icon\">③</div> <div> <h3>폴더블 사전예약</h3> <p>단골등록한 매장에 폴더블 사전예약을 요청해 주세요.</p> </div> </article> <div class=\"method-divider\">↓</div> <article class=\"method-card\"> <div class=\"method-icon\">④</div> <div> <h3>쿠폰 저장 후 매장에서 제시</h3> <p>조건에 맞는 쿠폰 이미지를 저장하고 방문 시 직원에게 보여 주세요.</p> </div> </article> </div> </section> <section class=\"section coupon-zone\" aria-labelledby=\"coupon-title\"> <h2 class=\"section-title\" id=\"coupon-title\">추가 할인 쿠폰</h2> <p class=\"section-desc\"> 단골등록과 폴더블 사전예약을 완료한 고객님께 조건에 맞는 쿠폰 혜택을 드립니다. </p> <div class=\"coupon-list\"> <article class=\"coupon-card\"> <span class=\"coupon-label\">당일 사전예약 완료</span> <h3>10만원 추가 할인 쿠폰</h3> <div class=\"coupon-amount\"> <strong>10</strong> <span>만원</span> </div> <p class=\"coupon-condition\"> 단골등록 당일 폴더블 사전예약 완료 고객 대상<br /> 매장 방문 시 저장한 쿠폰 이미지를 제시해 주세요. </p> <button class=\"save-btn\" type=\"button\" onclick=\"downloadCoupon('sameDay')\"> 이미지 저장하기 </button> </article> <article class=\"coupon-card\"> <span class=\"coupon-label\">이후 사전예약 완료</span> <h3>5만원 추가 할인 쿠폰</h3> <div class=\"coupon-amount\"> <strong>5</strong> <span>만원</span> </div> <p class=\"coupon-condition\"> 단골등록 후 이후 일정에 폴더블 사전예약 완료 고객 대상<br /> 매장 방문 시 저장한 쿠폰 이미지를 제시해 주세요. </p> <button class=\"save-btn\" type=\"button\" onclick=\"downloadCoupon('later')\"> 이미지 저장하기 </button> </article> </div> <p class=\"coupon-note\"> 두 쿠폰은 중복 사용이 불가하며, 단골등록 및 사전예약 완료 확인 후 사용 가능합니다. </p> </section> <section class=\"section\" aria-labelledby=\"notice-title\"> <h2 class=\"section-title\" id=\"notice-title\">꼭 확인해 주세요</h2> <div class=\"notice-card\"> <ul class=\"notice-list\"> <li>단골등록 및 폴더블 사전예약 완료 고객만 사용 가능합니다.</li> <li>10만원 쿠폰과 5만원 쿠폰은 중복 사용이 불가합니다.</li> <li>매장 방문 시 저장한 쿠폰 이미지를 직원에게 제시해 주세요.</li> <li>실제 사전예약 등록은 매장에서 진행됩니다.</li> <li>쿠폰 적용 가능 여부는 매장 확인 기준에 따라 달라질 수 있습니다.</li> </ul> </div> </section> <section class=\"section\" aria-labelledby=\"trainer-title\"> <div class=\"trainer-card\"> <span class=\"trainer-badge\">별도 체험 콘텐츠</span> <h2 id=\"trainer-title\">나와 어울리는 트레이너를 만나보세요</h2> <p> 트레이너 성향 테스트와 이미지 만들기는 쿠폰 혜택과 별개의 재미 콘텐츠입니다. 이벤트 참여 후 가볍게 즐겨보세요. </p> <div class=\"trainer-actions\"> <a class=\"secondary-btn\" href=\"TRAINER_TEST_URL\"> 트레이너 성향 테스트 </a> <a class=\"secondary-btn\" href=\"TRAINER_IMAGE_URL\"> 트레이너 이미지 만들기 </a> </div> </div> </section> <footer class=\"footer\"> 본 페이지는 이벤트 안내용 페이지입니다.<br /> 세부 혜택 및 적용 조건은 매장 확인 기준에 따라 달라질 수 있습니다. </footer> </main> <div class=\"sticky-cta\"> <a class=\"primary-btn\" href=\"https://m.tworld.co.kr/customer/store\" target=\"_blank\" rel=\"noopener\"> 단골등록 하러가기 </a> </div> <div class=\"toast\" id=\"toast\" role=\"status\" aria-live=\"polite\"></div> <script> const COUPONS = { sameDay: { badge: \"당일 사전예약 완료\", amount: \"10만원\", title: \"10만원 추가 할인 쿠폰\", condition: \"단골등록 당일 폴더블 사전예약 완료 고객 대상\", fileName: \"dangol-foldable-100000-coupon\" }, later: { badge: \"이후 사전예약 완료\", amount: \"5만원\", title: \"5만원 추가 할인 쿠폰\", condition: \"단골등록 후 이후 일정에 폴더블 사전예약 완료 고객 대상\", fileName: \"dangol-foldable-50000-coupon\" } }; function getTodayString() { const today = new Date(); const yyyy = today.getFullYear(); const mm = String(today.getMonth() + 1).padStart(2, \"0\"); const dd = String(today.getDate()).padStart(2, \"0\"); return `${yyyy}.${mm}.${dd}`; } function showToast(message) { const toast = document.getElementById(\"toast\"); toast.textContent = message; toast.classList.add(\"is-active\"); window.clearTimeout(window.__toastTimer); window.__toastTimer = window.setTimeout(() => { toast.classList.remove(\"is-active\"); }, 3200); } function roundRect(ctx, x, y, width, height, radius) { const r = Math.min(radius, width / 2, height / 2); ctx.beginPath(); ctx.moveTo(x + r, y); ctx.arcTo(x + width, y, x + width, y + height, r); ctx.arcTo(x + width, y + height, x, y + height, r); ctx.arcTo(x, y + height, x, y, r); ctx.arcTo(x, y, x + width, y, r); ctx.closePath(); } function drawText(ctx, text, x, y, options = {}) { const { size = 36, weight = \"700\", color = \"#171725\", align = \"left\", baseline = \"top\", maxWidth = undefined } = options; ctx.font = `${weight} ${size}px -apple-system, BlinkMacSystemFont, \"Apple SD Gothic Neo\", \"Pretendard\", \"Noto Sans KR\", sans-serif`; ctx.fillStyle = color; ctx.textAlign = align; ctx.textBaseline = baseline; if (maxWidth) { ctx.fillText(text, x, y, maxWidth); } else { ctx.fillText(text, x, y); } } function drawWrappedText(ctx, text, x, y, maxWidth, lineHeight, options = {}) { const words = text.split(\" \"); let line = \"\"; let currentY = y; for (let i = 0; i < words.length; i++) { const testLine = line + words[i] + \" \"; const metrics = ctx.measureText(testLine); const testWidth = metrics.width; if (testWidth > maxWidth && i > 0) { drawText(ctx, line.trim(), x, currentY, options); line = words[i] + \" \"; currentY += lineHeight; } else { line = testLine; } } drawText(ctx, line.trim(), x, currentY, options); return currentY + lineHeight; } function createCouponCanvas(type) { const coupon = COUPONS[type]; const issueDate = getTodayString(); const canvas = document.createElement(\"canvas\"); const width = 1080; const height = 1500; canvas.width = width; canvas.height = height; const ctx = canvas.getContext(\"2d\"); const bg = ctx.createLinearGradient(0, 0, width, height); bg.addColorStop(0, \"#f6f3ff\"); bg.addColorStop(0.48, \"#ffffff\"); bg.addColorStop(1, \"#eaf6ff\"); ctx.fillStyle = bg; ctx.fillRect(0, 0, width, height); const orb1 = ctx.createRadialGradient(180, 150, 20, 180, 150, 360); orb1.addColorStop(0, \"rgba(109, 93, 252, 0.24)\"); orb1.addColorStop(1, \"rgba(109, 93, 252, 0)\"); ctx.fillStyle = orb1; ctx.fillRect(0, 0, width, height); const orb2 = ctx.createRadialGradient(920, 230, 20, 920, 230, 380); orb2.addColorStop(0, \"rgba(30, 155, 255, 0.22)\"); orb2.addColorStop(1, \"rgba(30, 155, 255, 0)\"); ctx.fillStyle = orb2; ctx.fillRect(0, 0, width, height); ctx.save(); roundRect(ctx, 80, 94, 920, 1310, 58); ctx.fillStyle = \"#ffffff\"; ctx.shadowColor = \"rgba(45, 43, 101, 0.18)\"; ctx.shadowBlur = 42; ctx.shadowOffsetY = 24; ctx.fill(); ctx.restore(); ctx.save(); roundRect(ctx, 80, 94, 920, 1310, 58); ctx.strokeStyle = \"rgba(109, 93, 252, 0.18)\"; ctx.lineWidth = 3; ctx.stroke(); ctx.restore(); ctx.save(); roundRect(ctx, 140, 160, 260, 64, 32); ctx.fillStyle = \"#ece8ff\"; ctx.fill(); drawText(ctx, \"SK텔레콤 단골 혜택\", 270, 194, { size: 28, weight: \"900\", color: \"#3b2f98\", align: \"center\", baseline: \"middle\" }); ctx.restore(); drawText(ctx, \"포켓몬 협업 기념\", 140, 292, { size: 45, weight: \"900\", color: \"#25245f\" }); drawText(ctx, \"단골등록 이벤트\", 140, 352, { size: 67, weight: \"950\", color: \"#25245f\" }); ctx.save(); roundRect(ctx, 140, 470, 800, 92, 46); const pillGradient = ctx.createLinearGradient(140, 470, 940, 562); pillGradient.addColorStop(0, \"#6d5dfc\"); pillGradient.addColorStop(1, \"#1e9bff\"); ctx.fillStyle = pillGradient; ctx.fill(); drawText(ctx, coupon.badge, 540, 516, { size: 36, weight: \"900\", color: \"#ffffff\", align: \"center\", baseline: \"middle\" }); ctx.restore(); drawText(ctx, coupon.title, 540, 640, { size: 56, weight: \"950\", color: \"#171725\", align: \"center\", baseline: \"middle\", maxWidth: 820 }); drawText(ctx, coupon.amount, 540, 770, { size: 132, weight: \"950\", color: \"#6d5dfc\", align: \"center\", baseline: \"middle\" }); drawText(ctx, \"추가 할인\", 540, 874, { size: 42, weight: \"900\", color: \"#25245f\", align: \"center\", baseline: \"middle\" }); ctx.save(); ctx.setLineDash([18, 16]); ctx.strokeStyle = \"rgba(109, 93, 252, 0.28)\"; ctx.lineWidth = 3; ctx.beginPath(); ctx.moveTo(150, 965); ctx.lineTo(930, 965); ctx.stroke(); ctx.restore(); ctx.save(); roundRect(ctx, 140, 1030, 800, 214, 34); ctx.fillStyle = \"#f7f8ff\"; ctx.fill(); ctx.restore(); drawText(ctx, \"사용조건\", 190, 1084, { size: 31, weight: \"950\", color: \"#3b2f98\" }); drawWrappedText(ctx, coupon.condition, 190, 1135, 700, 42, { size: 30, weight: \"760\", color: \"#56566f\" }); drawText(ctx, \"중복사용 불가 · 매장 방문 시 쿠폰 이미지 제시\", 190, 1210, { size: 28, weight: \"800\", color: \"#56566f\", maxWidth: 700 }); drawText(ctx, `발급일 ${issueDate}`, 140, 1320, { size: 29, weight: \"850\", color: \"#8a8aa3\" }); drawText(ctx, \"단골등록 + 폴더블 사전예약 완료 고객 대상\", 940, 1320, { size: 27, weight: \"850\", color: \"#8a8aa3\", align: \"right\" }); ctx.save(); ctx.globalAlpha = 0.09; drawText(ctx, \"DANGOL COUPON\", 540, 1450, { size: 72, weight: \"950\", color: \"#25245f\", align: \"center\", baseline: \"middle\" }); ctx.restore(); return canvas; } function downloadCoupon(type) { const coupon = COUPONS[type]; const canvas = createCouponCanvas(type); const issueDate = getTodayString().replaceAll(\".\", \"\"); canvas.toBlob((blob) => { if (!blob) { showToast(\"쿠폰 이미지를 만들지 못했어요. 다시 시도해 주세요.\"); return; } const url = URL.createObjectURL(blob); const link = document.createElement(\"a\"); link.href = url; link.download = `${coupon.fileName}-${issueDate}.png`; document.body.appendChild(link); link.click(); document.body.removeChild(link); window.setTimeout(() => URL.revokeObjectURL(url), 1000); showToast(\"쿠폰 이미지가 저장되었어요. 저장이 안 보이면 다운로드 폴더 또는 사진 앱을 확인해 주세요.\"); }, \"image/png\", 1); } </script> </body> </html> ``` --- ## Cursor에 추가로 시키면 좋은 개선 요청 ```text 위 페이지를 구현한 뒤, 모바일 실제 화면 기준으로 아래를 추가 점검해줘. 1. iPhone Safari와 Android Chrome에서 쿠폰 이미지 저장 버튼이 정상 동작하는지 확인 2. 쿠폰 이미지가 흐릿하지 않게 1080px 이상 해상도로 저장되는지 확인 3. CTA 버튼 터치 영역이 충분히 큰지 확인 4. 긴 문구가 작은 화면에서 줄바꿈 깨지지 않는지 확인 5. TRAINER_TEST_URL, TRAINER_IMAGE_URL은 나중에 실제 URL로 교체하기 쉽게 상단 JS 상수로 분리해줘 6. 운영 배포 전 수정해야 할 문구는 주석으로 표시해줘 ```\n</user_query>"}]}}
